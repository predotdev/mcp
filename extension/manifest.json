{
  "manifest_version": 3,
  "name": "pre.dev",
  "description": "Let pre.dev web runs you start do steps in this Chrome, signed in as you. It asks you before each new site.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "pre.dev",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.mjs", "type": "module" },
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["https://api.pre.dev/*"]
}
